{
  "name": "elegant-passwords",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cli": "tsdown && chmod +x dist-cli/tep.mjs",
    "tep": "node dist-cli/tep.mjs",
    "link:cli": "pnpm build:cli && node scripts/linkCli.mjs",
    "unlink:cli": "node scripts/linkCli.mjs --remove",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test --project built",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:titles": "node scripts/testTitles.mjs",
    "stats": "node scripts/devStats.mjs",
    "measure:modes": "MEASURE_MODES=1 vitest run src/lib/modeProfiles.test.ts --reporter=verbose --silent=false",
    "common:passwords": "node scripts/commonPasswords.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "bin": {
    "tep": "dist-cli/tep.mjs"
  }
}
